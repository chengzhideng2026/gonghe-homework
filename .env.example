LLM_API_KEY=
LLM_MODEL=qwen3.8-max
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ERPNEXT_URL=http://localhost:8080
ERPNEXT_API_KEY=crestwind-agent
ERPNEXT_API_SECRET=crestwind-agent-secret
REFERENCE_DATE=2025-10-15

# Optional request controls; omit thinking options for providers without them.
# Remote API base URLs require HTTPS. Loopback HTTP is allowed for local ERP.
# API redirects are refused; configure the final endpoint without URL credentials/query.
LLM_TIMEOUT=180
LLM_TURN_TIMEOUT=600
LLM_MAX_ROUNDS=16
# Client-side defaults for this demo; set these to the customer's actual limits.
# Cached business values are observations, not live state. 0 disables read reuse.
ERP_READ_CACHE_TTL=30
ERP_META_CACHE_TTL=600
ERP_MAX_REQUESTS_PER_TURN=40
ERP_MAX_REQUESTS_PER_MINUTE=120
ERP_MIN_REQUEST_INTERVAL=0.25
# Qwen Model Studio example: qwen3.8-max
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_ENABLE_THINKING=true
LLM_THINKING_BUDGET=4096
